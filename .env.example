# Company-wide store listings (not per-client). Copy to .env
# Leave a URL empty until that unlisted listing is live — /download shows "coming soon".

# CE OneSource Operations — com.ceonesource.residentnext
NEXT_PUBLIC_OPERATIONS_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.ceonesource.residentnext
NEXT_PUBLIC_OPERATIONS_APP_STORE_URL=

# ClaimTrack (Warranty) — com.ceonesource.warranty
NEXT_PUBLIC_WARRANTY_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.ceonesource.warranty
NEXT_PUBLIC_WARRANTY_APP_STORE_URL=

# Optional: lock this web build to one product (native shells use /go/operations or /go/warranty).
# NEXT_PUBLIC_APP_PROFILE=operations

# Dev only. Never set on Vercel.
# CEO_ALLOW_INSECURE_TLS=1
